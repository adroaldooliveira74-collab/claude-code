{
  "name": "perito-laudo",
  "version": "1.0.0",
  "description": "Perito · Laudo — app de perícias judiciais de SST (UrbanClin), com IA Gemini. Roda como site/PWA (celular e PC) e como executável desktop via Electron.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "br.com.urbanclin.peritolaudo",
    "productName": "Perito Laudo",
    "files": ["index.html", "vendor/**", "icon-192.png", "icon-512.png", "manifest.webmanifest", "sw.js", "electron/**"],
    "win": { "target": ["nsis", "portable"], "icon": "icon-512.png" },
    "linux": { "target": ["AppImage"], "icon": "icon-512.png" },
    "mac": { "target": ["dmg"], "icon": "icon-512.png" }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
